__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# Virtual environments (uv creates .venv/ by default)
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Packaging / build artifacts
# ---------------------------------------------------------------------------
build/
dist/
*.egg
MANIFEST

# ---------------------------------------------------------------------------
# Test / type-check caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Logs and local scratch output
# ---------------------------------------------------------------------------
*.log
build_out.txt

# ---------------------------------------------------------------------------
# Local, machine-specific state
# ---------------------------------------------------------------------------
# The app writes its settings to config.json and its signed-in session to
# cookies.txt. Both are per-user: config.json holds an absolute output path
# and cookies.txt holds real session tokens. Neither is tracked. Commit
# config.example.json instead to document the available keys.
config.json
config.local.json
cookies.txt
*.har

# Downloaded media. The default output directory lives in the source tree on
# a fresh checkout, so without this a single run leaves multi-hundred-megabyte
# MP3s staged for the next `git add -A`.
downloads/
*.mp3
*.m4a
*.opus
*.webm
*.mkv
*.part
*.ytdl
*.tmp

# ---------------------------------------------------------------------------
# Editors, OS, and CI
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
